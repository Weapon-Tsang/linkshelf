# LinkShelf local defaults. Copy to .env.local for local development.
NODE_ENV=development

# Required in production. Use at least 32 bytes of non-whitespace.
AUTH_SECRET=

# Required in production for Auth.js callback generation.
# Example: https://linkshelf.example.com
NEXTAUTH_URL=

# Required in production for Google OAuth.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Local SQLite path. Sprint 26 will replace this with the production persistence contract.
LINKSHELF_DB_PATH=./data/linkshelf.db
