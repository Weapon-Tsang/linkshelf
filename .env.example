# LinkShelf local defaults. Copy to .env.local for local development.
NODE_ENV=development
PORT=3000
HOSTNAME=0.0.0.0

# Required in production. Use at least 32 bytes of non-whitespace.
AUTH_SECRET=

# Required in production for Auth.js callback generation.
# Example: https://linkshelf.example.com
NEXTAUTH_URL=

# Required in production for Google OAuth.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Local SQLite path. In production, set this to an absolute path on persistent
# storage, such as /var/lib/linkshelf/linkshelf.db.
# Docker/Compose deployment default:
LINKSHELF_DB_PATH=/data/linkshelf/linkshelf.db

# Optional outside production. Set to 1 to emit structured monitoring events to
# stdout during local or staging smoke tests.
LINKSHELF_MONITORING_STDOUT=

# Amazon integration. PA-API is blocked because Amazon marked it deprecated on
# 2026-05-15. Use fixtures locally; production should stay disabled until
# Creators API docs and credentials are available.
AMAZON_INTEGRATION_MODE=
AMAZON_CREATORS_API_BASE_URL=
AMAZON_CREATORS_API_KEY=
AMAZON_PARTNER_TAG=
